{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npm run dev -- --host 127.0.0.1 --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:4173/"
      ],
      "settings": {
        "preset": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.55
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": "off",
        "categories:pwa": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
